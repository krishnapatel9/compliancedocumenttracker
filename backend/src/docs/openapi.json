    "/api/audit-logs": {
      "get": {
        "tags": [
          "Audit"
        ],
        "summary": "Audit trail (append-only), newest first",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "LOGIN_SUCCESS",
                "LOGIN_FAILED",
                "DOCUMENT_CREATED",
                "DOCUMENT_UPDATED",
                "DOCUMENT_DOWNLOADED",
                "DOCUMENT_DELETED",
                "DOCUMENT_RESTORED",
                "DOCUMENT_PURGED",
                "FRAMEWORK_LINKED",
                "FRAMEWORK_UNLINKED",
                "EXPIRY_SCAN_RUN"
              ]
            }
          },
          {
            "name": "entityId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "A document id: returns that document's full history, including framework links that reference it"
          },
          {
            "name": "actor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Case-insensitive match on the actor email"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "First day to include (YYYY-MM-DD, in the business time zone APP_TIMEZONE)"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Last day to include (YYYY-MM-DD, in the business time zone APP_TIMEZONE)"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLogPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
