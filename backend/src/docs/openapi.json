{
  "openapi": "3.0.3",
  "info": {
    "title": "DocShield Compliance Document Tracker API",
    "version": "1.2.0",
    "description": "Manage compliance documents, expiry status, framework mappings and reminder emails.\n\nAll `/api/*` routes except `/api/auth/login`, `/api/health` and `/api/services/cron/run` need `Authorization: Bearer <token>`. Errors are always JSON: `{ \"error\": \"...\" }`, with `details` for validation failures.\n\n**Deleting is soft.** `DELETE /api/documents/{id}` moves a document to the trash, where it can be restored for `RETENTION_DAYS` (default 30) before it is purged. **Every change is recorded** in an append-only audit trail (`GET /api/audit-logs`)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as this page"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Documents"
    },
    {
      "name": "Dashboard"
    },
    {
      "name": "Frameworks"
    },
    {
      "name": "Notifications"
    },
    {
      "name": "Services"
    },
    {
      "name": "System"
    },
    {
      "name": "Audit"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cronSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-cron-secret"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "FileMeta": {
        "type": "object",
        "nullable": true,
        "properties": {
          "fileName": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "license",
              "certificate",
              "insurance",
              "contract",
              "permit",
              "tax_document"
            ]
          },
          "issueDate": {
            "type": "string",
            "format": "date-time",
            "description": "UTC midnight of the calendar date"
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time",
            "description": "UTC midnight of the calendar date"
          },
          "notifyEmail": {
            "type": "string",
            "format": "email"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "hasFile": {
            "type": "boolean",
            "description": "False when no PDF is stored; re-upload via PUT"
          },
          "file": {
            "$ref": "#/components/schemas/FileMeta"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expiring_soon",
              "expired"
            ],
            "description": "expired < today; expiring_soon 0-30 days; active > 30 days"
          },
          "daysRemaining": {
            "type": "integer"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Set while the document is in the trash"
          },
          "purgeAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When a trashed document will be permanently deleted"
          }
        }
      },
      "DocumentPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "totalItems": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "active": {
            "type": "integer"
          },
          "expiringSoon": {
            "type": "integer"
          },
          "expired": {
            "type": "integer"
          },
          "expiring7d": {
            "type": "integer"
          },
          "expiring30d": {
            "type": "integer"
          },
          "expiring60d": {
            "type": "integer"
          },
          "expiring90d": {
            "type": "integer"
          },
          "categories": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "healthRate": {
            "type": "integer",
            "description": "Percent of documents that are not expired"
          },
          "warningsCount": {
            "type": "integer"
          },
          "monthlyUploads": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "month": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "FrameworkControl": {
        "type": "object",
        "properties": {
          "framework": {
            "type": "string",
            "enum": [
              "SOC2",
              "ISO27001",
              "GDPR"
            ]
          },
          "controlCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "documentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "linkedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "document": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "expiryDate": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string"
              },
              "daysRemaining": {
                "type": "integer"
              }
            }
          }
        }
      },
      "LinkRequest": {
        "type": "object",
        "required": [
          "framework",
          "controlCode"
        ],
        "properties": {
          "framework": {
            "type": "string"
          },
          "controlCode": {
            "type": "string"
          },
          "documentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "null unlinks the control"
          }
        }
      },
      "NotificationLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "daysBefore": {
            "type": "integer",
            "enum": [
              30,
              15,
              7,
              0
            ]
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time"
          },
          "document": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "expiryDate": {
                "type": "string",
                "format": "date-time"
              },
              "notifyEmail": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "daysRemaining": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ScanResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "scannedThresholds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "sentCount": {
            "type": "integer"
          },
          "emailsSent": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "skippedDuplicates": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "failed": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "disconnected"
            ]
          },
          "alerts": {
            "type": "object",
            "properties": {
              "lastRunAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "lastSuccessAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "lastError": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "AuditLogEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "actorEmail": {
            "type": "string",
            "description": "Admin email, the attempted email for failed logins, or 'system'"
          },
          "action": {
            "type": "string",
            "enum": [
              "LOGIN_SUCCESS",
              "LOGIN_FAILED",
              "DOCUMENT_CREATED",
              "DOCUMENT_UPDATED",
              "DOCUMENT_DOWNLOADED",
              "DOCUMENT_DELETED",
              "DOCUMENT_RESTORED",
              "DOCUMENT_PURGED",
              "FRAMEWORK_LINKED",
              "FRAMEWORK_UNLINKED",
              "EXPIRY_SCAN_RUN"
            ]
          },
          "entityType": {
            "type": "string",
            "enum": [
              "document",
              "framework_control",
              "admin",
              "system"
            ]
          },
          "entityId": {
            "type": "string",
            "nullable": true
          },
          "documentTitle": {
            "type": "string",
            "nullable": true,
            "description": "Title at the time, so the entry stays readable after a purge"
          },
          "details": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "For updates: { changes: { field: { from, to } }, fileReplaced }"
          },
          "ip": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AuditLogPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditLogEntry"
            }
          },
          "totalItems": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in and receive a JWT",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "admin": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Email or password missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed attempts (10 per 15 minutes per IP)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "List documents",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 150
            },
            "description": "Matches title or description"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "license",
                "certificate",
                "insurance",
                "contract",
                "permit",
                "tax_document"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "expiring_soon",
                "expired"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "expiryDate",
                "issueDate",
                "title",
                "deletedAt"
              ],
              "default": "createdAt"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          },
          {
            "name": "trash",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            },
            "description": "true lists the trash (soft-deleted documents) instead of live documents"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of documents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Create a document with its PDF",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "category",
                  "issueDate",
                  "expiryDate",
                  "notifyEmail",
                  "file"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 150
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "license",
                      "certificate",
                      "insurance",
                      "contract",
                      "permit",
                      "tax_document"
                    ]
                  },
                  "issueDate": {
                    "type": "string",
                    "format": "date",
                    "description": "YYYY-MM-DD, not in the future"
                  },
                  "expiryDate": {
                    "type": "string",
                    "format": "date",
                    "description": "YYYY-MM-DD, after issueDate"
                  },
                  "notifyEmail": {
                    "type": "string",
                    "format": "email"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "PDF, max 5 MB, verified by magic bytes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "document": {
                      "$ref": "#/components/schemas/Document"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, missing file, or not a PDF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "File larger than 5 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get one document",
        "responses": {
          "200": {
            "description": "The document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "404": {
            "description": "Not found (or malformed id)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Documents"
        ],
        "summary": "Update metadata and optionally replace the PDF",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 150
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "license",
                      "certificate",
                      "insurance",
                      "contract",
                      "permit",
                      "tax_document"
                    ]
                  },
                  "issueDate": {
                    "type": "string",
                    "format": "date",
                    "description": "YYYY-MM-DD, not in the future"
                  },
                  "expiryDate": {
                    "type": "string",
                    "format": "date",
                    "description": "YYYY-MM-DD, after issueDate"
                  },
                  "notifyEmail": {
                    "type": "string",
                    "format": "email"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "PDF, max 5 MB, verified by magic bytes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "document": {
                      "$ref": "#/components/schemas/Document"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "File larger than 5 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Move a document to the trash (soft delete)",
        "responses": {
          "200": {
            "description": "Moved to the trash",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "restorableUntil": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
