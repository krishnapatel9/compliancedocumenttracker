PORT=5000
NODE_ENV=development
# Local Postgres (npm run db:local) or a hosted one (Neon/Supabase: use the DIRECT connection string; the pooled one can hang `prisma migrate deploy`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/compliance_tracker?schema=public"
# At least 32 random characters, e.g. `openssl rand -hex 32`. The server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Comma-separated browser origins allowed to call the API directly (empty = same-origin only)
CORS_ORIGINS=
# Number of proxy hops in front of the API (Vercel -> Render is usually 2; verify by logging req.ip)
TRUST_PROXY=
APP_TIMEZONE=Asia/Kolkata
# Days a deleted document stays restorable in the trash before it is purged for good
RETENTION_DAYS=30
# Mail: required in production. Leave SMTP_HOST empty in development to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DocShield <no-reply@example.com>"
# Secret for the external scheduler (POST /api/services/cron/run with header x-cron-secret)
CRON_SECRET=
# Admin creation: npm run db:create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo seed only (never run in production): inbox that receives seeded documents' reminders
DEMO_NOTIFY_EMAIL=
