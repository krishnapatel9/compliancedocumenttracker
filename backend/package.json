{
    "name": "backend",
    "version": "1.0.0",
    "description": "Compliance Document Tracker Backend",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "dev": "nodemon src/app.js",
        "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
        "db:migrate": "prisma migrate dev",
        "db:seed": "node prisma/seed.js",
        "prisma:generate": "prisma generate",
        "start:prod": "prisma migrate deploy && node src/app.js",
        "db:deploy": "prisma migrate deploy",
        "db:create-admin": "node prisma/create-admin.js",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@prisma/client": "^5.12.1",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^8.6.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^4.6.0",
        "nodemailer": "^10.6.1",
        "prisma": "^5.12.1",
        "swagger-ui-dist": "^5.17.14",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "nodemon": "^3.1.0",
        "supertest": "^7.0.0"
    },
    "engines": {
        "node": ">=20"
    }
}
