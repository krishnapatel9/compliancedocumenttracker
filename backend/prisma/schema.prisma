datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum DocumentCategory {
  license
  certificate
  insurance
  contract
  permit
  tax_document
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin")
}

model Document {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  category      DocumentCategory
  issueDate     DateTime       @map("issue_date") @db.Date
  expiryDate    DateTime       @map("expiry_date") @db.Date
  notifyEmail   String         @map("notify_email")
  description   String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  // Soft delete: set when moved to the trash; purged after RETENTION_DAYS (see services/retention.js)
  deletedAt     DateTime?      @map("deleted_at")

  file              DocumentFile?
  notifications     Notification[]
  frameworkControls FrameworkControl[]

  @@index([expiryDate])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("documents")
}

// PDF bytes live in Postgres: hosts with ephemeral disks (Render free tier) lose local files.
// Kept in a separate table so list/detail queries never load the bytes.
model DocumentFile {
  documentId String   @id @map("document_id") @db.Uuid
  fileName   String   @map("file_name")
  mimeType   String   @default("application/pdf") @map("mime_type")
  size       Int
  data       Bytes
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_files")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  // The expiry date this warning was for. Renewing a document (new expiry date)
  // starts a fresh warning cycle instead of matching the old warnings.
  expiryDate DateTime @map("expiry_date") @db.Date
  // Threshold that was crossed: 30, 15, 7, or 0 (expired / expires today)
  daysBefore Int      @map("days_before")
  sentAt     DateTime @default(now()) @map("sent_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, expiryDate, daysBefore])
  @@map("notifications")
}

model FrameworkControl {
  id          String    @id @default(uuid()) @db.Uuid
  framework   String    // 'SOC2', 'ISO27001', 'GDPR'
  controlCode String    @map("control_code") // e.g., 'CC1.1', 'A.9.1'
  name        String
  description String?
  documentId  String?   @map("document_id") @db.Uuid
  linkedAt    DateTime? @map("linked_at")

  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([framework, controlCode])
  @@map("framework_controls")
}

// Append-only record of who did what. No foreign keys on purpose: entries must outlive the
// document (or admin) they describe. A database trigger rejects UPDATE, DELETE and TRUNCATE.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  actorId       String?  @map("actor_id") @db.Uuid
  actorEmail    String   @map("actor_email")   // 'system' for scheduled jobs
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  documentTitle String?  @map("document_title") // snapshot, so the entry is readable after a purge
  details       Json?
  ip            String?

  @@index([createdAt])
  @@index([entityId])
  @@index([action])
  @@map("audit_logs")
}
